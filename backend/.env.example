# Copy to .env and adjust. Every value below is optional; these are the defaults in app/config.py.

# SQLite database file. The folder is created automatically.
DATABASE_URL=sqlite:///./data/empath.db

# Shared development key sent as the X-API-Key header. Minimum 16 characters.
# Change it for anything other than a local demo, and never put a real key in frontend code.
API_KEY=local-demo-key-change-me

# Keep false until the study has ethical approval. When false, private student recordings are refused.
ENABLE_RESEARCH_MODE=false

# Browser origins allowed to call the API (JSON array). Restart the server after changes.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173","http://localhost:8081","http://127.0.0.1:8081"]

# Request size limits in bytes: general JSON requests, and voice uploads.
MAX_REQUEST_BYTES=1048576
MAX_AUDIO_REQUEST_BYTES=9437184

# Trained model folders.
VOICE_MODEL_DIR=models/voice
RISK_MODEL_DIR=models/risk
